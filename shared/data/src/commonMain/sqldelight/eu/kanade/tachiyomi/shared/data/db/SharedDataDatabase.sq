CREATE TABLE mangas (
  _id INTEGER PRIMARY KEY,
  source INTEGER AS Long NOT NULL,
  url TEXT NOT NULL,
  artist TEXT,
  author TEXT,
  description TEXT,
  genre TEXT,
  title TEXT NOT NULL,
  status INTEGER AS Long NOT NULL,
  thumbnail_url TEXT,
  favorite INTEGER AS Boolean NOT NULL DEFAULT 0,
  last_update INTEGER AS Long,
  initialized INTEGER AS Boolean NOT NULL,
  viewer INTEGER AS Long NOT NULL DEFAULT 0,
  hideTitle INTEGER AS Boolean NOT NULL DEFAULT 0,
  chapter_flags INTEGER AS Long NOT NULL DEFAULT 0,
  date_added INTEGER AS Long,
  filtered_scanlators TEXT,
  update_strategy INTEGER AS Long NOT NULL DEFAULT 0
);

CREATE TABLE chapters (
  _id INTEGER PRIMARY KEY,
  manga_id INTEGER AS Long NOT NULL REFERENCES mangas(_id) ON DELETE CASCADE,
  url TEXT NOT NULL,
  name TEXT NOT NULL,
  scanlator TEXT,
  read INTEGER AS Boolean NOT NULL,
  bookmark INTEGER AS Boolean NOT NULL,
  last_page_read INTEGER AS Long NOT NULL DEFAULT 0,
  pages_left INTEGER AS Long NOT NULL DEFAULT 0,
  chapter_number REAL NOT NULL,
  source_order INTEGER AS Long NOT NULL DEFAULT 0,
  date_fetch INTEGER AS Long NOT NULL,
  date_upload INTEGER AS Long NOT NULL
);

selectMangaById:
SELECT * FROM mangas
WHERE _id = ?;

selectAllManga:
SELECT * FROM mangas;

upsertManga:
INSERT OR REPLACE INTO mangas(
  _id, source, url, artist, author, description, genre, title, status,
  thumbnail_url, favorite, last_update, initialized, viewer, hideTitle,
  chapter_flags, date_added, filtered_scanlators, update_strategy
)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

selectChaptersByMangaId:
SELECT * FROM chapters
WHERE manga_id = ?
ORDER BY source_order DESC;

upsertChapter:
INSERT OR REPLACE INTO chapters(
  _id, manga_id, url, name, scanlator, read, bookmark, last_page_read,
  pages_left, chapter_number, source_order, date_fetch, date_upload
)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

copyMangaFromLegacy:
INSERT OR IGNORE INTO mangas(
  _id, source, url, artist, author, description, genre, title, status,
  thumbnail_url, favorite, last_update, initialized, viewer, hideTitle,
  chapter_flags, date_added, filtered_scanlators, update_strategy
)
SELECT _id, source, url, artist, author, description, genre, title, status,
  thumbnail_url, favorite, last_update, initialized, viewer, hideTitle,
  chapter_flags, date_added, filtered_scanlators, update_strategy
FROM legacy_mangas;

copyChapterFromLegacy:
INSERT OR IGNORE INTO chapters(
  _id, manga_id, url, name, scanlator, read, bookmark, last_page_read,
  pages_left, chapter_number, source_order, date_fetch, date_upload
)
SELECT _id, manga_id, url, name, scanlator, read, bookmark, last_page_read,
  pages_left, chapter_number, source_order, date_fetch, date_upload
FROM legacy_chapters;
