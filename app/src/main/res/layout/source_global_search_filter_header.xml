<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.button.MaterialButtonGroup xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/filter_button_group"
    style="@style/Widget.Tachiyomi.MaterialButtonGroup"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:spacing="4dp"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="8dp"
    android:paddingBottom="4dp">

    <com.google.android.material.button.MaterialButton
        android:id="@+id/pinned_button"
        style="@style/Widget.Tachiyomi.Button.OutlinedButton.Icon"
        app:icon="@drawable/ic_pin_checked_selector_24dp"
        android:text="@string/pinned_only" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/has_results_button"
        style="@style/Widget.Tachiyomi.Button.OutlinedButton.Icon"
        app:icon="@drawable/ic_search_check_24dp"
        android:text="@string/has_results" />

</com.google.android.material.button.MaterialButtonGroup>
